# Watches the shared data volume for the panel's apply signal (Hermes VM).
# The web panel (unprivileged) writes <data>/.apply-request with a timestamp; this
# path unit fires cloudhosting-applier.service whenever that file changes, which
# runs apply.sh on the HOST (docker control stays off the web surface).
#
# firstboot.sh installs these units automatically. Manual install (host):
#   sudo install -d -m0755 /usr/local/lib/cloudhosting
#   sudo install -m0755 apply.sh /usr/local/lib/cloudhosting/apply.sh
#   sudo cp cloudhosting-applier.path    /etc/systemd/system/
#   sudo cp cloudhosting-applier.service /etc/systemd/system/
#   printf 'PRODUCT=hermes\nCOMPOSE_FILE=/opt/hermes-vm/docker-compose.yml\nCOMPOSE_PROJECT_DIR=/opt/hermes-vm\nDATA_DIR=/opt/hermes-vm/data\n' \
#     | sudo tee /etc/cloudhosting-panel.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cloudhosting-applier.path
#
# PathChanged MUST match the host path of the shared data dir (the dir the panel
# mounts as /data). For this VM that is /opt/hermes-vm/data.

[Unit]
Description=Watch for CloudHosting AI Panel apply requests (Hermes)

[Path]
PathChanged=/opt/hermes-vm/data/.apply-request
Unit=cloudhosting-applier.service

[Install]
WantedBy=multi-user.target
