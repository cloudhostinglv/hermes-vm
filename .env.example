# Hermes Agent — per-client secrets/env. Copy to .env and fill in.
# The real .env is gitignored and injected per-client at provision time (cloud-init).
# This file is mounted into the container's data dir at /opt/data/.env.
#
# Env var names are confirmed against upstream:
#   docs/reference/environment-variables.md + docs/user-guide/messaging/telegram.md.

# === avots.ai backend (each client uses their OWN key) ===
# Auth header sent is: Authorization: Bearer av_mcp_<key>
AVOTS_API_KEY=av_mcp_REPLACE_ME

# Hermes reads OPENAI_API_KEY / OPENAI_BASE_URL for custom OpenAI-compatible
# endpoints. config.yaml already points model.api_key at ${AVOTS_API_KEY} and
# model.base_url at the avots URL; we mirror them here so the env-var fallback
# path also resolves to avots. Keep OPENAI_API_KEY equal to AVOTS_API_KEY.
OPENAI_API_KEY=av_mcp_REPLACE_ME
OPENAI_BASE_URL=https://api.avots.ai/openai/v1

# === Telegram (default messaging platform; long-polling = outbound-only) ===
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Comma-separated numeric Telegram user IDs allowed to talk to the bot
# (applies to DMs, groups, and forums). STRONGLY recommended — without an
# allowlist anyone who finds the bot can drive the agent. Get your id from @userinfobot.
TELEGRAM_ALLOWED_USERS=REPLACE_ME

# === File ownership (map container user -> host owner of ./data) ===
# Set these to the host user/group that owns the data dir so files stay writable.
# Defaults (10000) match the image. On most VMs the service user is uid/gid 1000.
HERMES_UID=10000
HERMES_GID=10000

# === Optional: local admin dashboard (off by default) ===
# Set to 1 AND start the dashboard profile to enable a loopback-only admin UI
# on 127.0.0.1:9119. Reach it via `ssh -L 9119:localhost:9119 <vm>`. Leave unset
# for the smallest attack surface.
# HERMES_DASHBOARD=1
