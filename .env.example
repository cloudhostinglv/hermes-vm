# Hermes Agent — per-client secrets/env. Copy to .env and fill in.
# The real .env is gitignored and injected per-client at provision time (autoinstall).
# This file is mounted into the container's data dir at /opt/data/.env and is ALSO
# read by docker compose for the panel/Caddy substitution (PANEL_*).
#
# Env var names are confirmed against upstream:
#   docs/reference/environment-variables.md + docs/user-guide/messaging/telegram.md.

# === CloudHosting setup panel + TLS ===
# Panel login password. REQUIRED — the panel fails closed (refuses to start) if empty.
# Use a strong unique value per VM.
PANEL_PASSWORD=REPLACE_ME
# Public host the panel is served on (TLS via Let's Encrypt). Leave BLANK to have
# firstboot.sh derive it from the primary IPv4 as vps-<3rd octet>-<4th octet>.cloudhosting.lv
# (e.g. 185.8.60.226 -> vps-60-226.cloudhosting.lv). The A-record already exists by
# convention, so HTTP-01 issuance just works. Set it explicitly to override.
PANEL_DOMAIN=

# === LLM provider key (avots.ai by default) ===
# The CLIENT normally sets the provider + key in the panel, which writes config.yaml +
# .env into ./data and signals a gateway restart. So this MAY be left BLANK here and
# filled in via the panel. Optionally PRE-INJECT it to skip the panel step.
# Auth header sent is: Authorization: Bearer av_mcp_<key>
AVOTS_API_KEY=
# Hermes reads OPENAI_API_KEY / OPENAI_BASE_URL for custom OpenAI-compatible endpoints.
# config.yaml points model.api_key at ${OPENAI_API_KEY}; keep these equal to the avots
# key + URL if you pre-inject. The panel rewrites all three when the client saves a key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.avots.ai/openai/v1

# === Telegram (default messaging platform; long-polling = outbound-only) ===
# OPTIONAL here — the client can set the bot token via the panel's Telegram guide.
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to the bot
# (applies to DMs, groups, and forums). STRONGLY recommended — without an
# allowlist anyone who finds the bot can drive the agent. Get your id from @userinfobot.
TELEGRAM_ALLOWED_USERS=

# === File ownership (map container user -> host owner of ./data) ===
# Both the Hermes agent AND the panel container run as this uid:gid so the panel's
# 0600 .env stays readable by the agent (see docker-compose.yml "UID / PERMS DECISION").
# Defaults (10000) match the Hermes image. firstboot.sh chowns ./data to this.
HERMES_UID=10000
HERMES_GID=10000

# === Optional: local admin dashboard (off by default) ===
# Set to 1 AND start the dashboard profile to enable a loopback-only admin UI
# on 127.0.0.1:9119. Reach it via `ssh -L 9119:localhost:9119 <vm>`. Leave unset
# for the smallest attack surface.
# HERMES_DASHBOARD=1
